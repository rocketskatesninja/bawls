
# HTTPS for the decoy domain(s), added once Let's Encrypt has issued the
# certificate. certbot's timer renews it and reloads Apache.
<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName {{DECOY_SERVER_NAME}}
{{DECOY_SERVER_ALIAS}}
    SSLEngine on
    SSLCertificateFile    {{DECOY_CERT}}
    SSLCertificateKeyFile {{DECOY_KEY}}
    ProxyPreserveHost On
    ProxyPass / http://127.0.0.1:{{DECOY_PORT}}/
    ProxyPassReverse / http://127.0.0.1:{{DECOY_PORT}}/
    ErrorLog  ${APACHE_LOG_DIR}/bawls_decoy_error.log
    # The decoy records every request itself, masked and with its own retention,
    # so the web server keeps no second copy of visitors' requests.
    CustomLog /dev/null combined
    ServerSignature Off
</VirtualHost>
</IfModule>
