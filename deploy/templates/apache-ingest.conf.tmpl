# {{MANAGED}}
#
# Sensor ingest: a plain-HTTP vhost on localhost only, so the decoy and the
# UFW sensor can POST /api/ingest (token-authenticated). Not reachable off
# the box.
Listen 127.0.0.1:{{INGEST_PORT}}
<VirtualHost 127.0.0.1:{{INGEST_PORT}}>
    ServerName bawls-ingest
    DocumentRoot {{INSTALL_DIR}}/public
    <Directory {{INSTALL_DIR}}/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require ip 127.0.0.1
    </Directory>
    <FilesMatch \.php$>
        SetHandler "proxy:unix:{{PHP_FPM_SOCK}}|fcgi://localhost"
    </FilesMatch>
    <FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|env|mmdb)$">
        Require all denied
    </FilesMatch>
    ErrorLog ${APACHE_LOG_DIR}/bawls_ingest_error.log
    CustomLog ${APACHE_LOG_DIR}/bawls_ingest_access.log combined
</VirtualHost>
