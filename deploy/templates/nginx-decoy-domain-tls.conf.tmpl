
# HTTPS for the decoy domain(s), added once Let's Encrypt has issued the
# certificate. certbot's timer renews it and reloads nginx.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{DECOY_SERVER_NAMES}};
    server_tokens off;

    ssl_certificate     {{DECOY_CERT}};
    ssl_certificate_key {{DECOY_KEY}};

    location / {
        proxy_pass http://127.0.0.1:{{DECOY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The decoy records every request itself, masked and with its own retention,
    # so the web server keeps no second copy of visitors' requests.
    access_log off;
    error_log  /var/log/nginx/bawls_decoy_error.log;
}
