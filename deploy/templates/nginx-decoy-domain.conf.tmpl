# {{MANAGED}}
#
# The decoy's own domain(s). Everything is proxied to the decoy over plain
# HTTP too (a honeypot has no reason to force HTTPS), except Let's Encrypt
# challenges, which are served from {{ACME_DIR}}.
server {
    listen 80;
    listen [::]:80;
    server_name {{DECOY_SERVER_NAMES}};
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root {{ACME_DIR}};
        default_type text/plain;
    }

    location / {
        proxy_pass http://127.0.0.1:{{DECOY_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The decoy records every request itself, masked and with its own retention,
    # so the web server keeps no second copy of visitors' requests.
    access_log off;
    error_log  /var/log/nginx/bawls_decoy_error.log;
}
