# {{MANAGED}}
#
# One ban request from bawls = a ban on every port, so an attacker caught on
# the decoy is dropped for every site on this server. ignoreip is a second
# safety net behind the app's never-block list; it also covers IPv6, which
# the app-side list can't.
#
# An IPv6 attacker is banned as its whole /64, which nftables only accepts
# in a set made for ranges: where fail2ban bans with nftables, the jail uses
# bawls' own copy of that action (action.d/bawls-nftables.conf).
#
# Unban: sudo fail2ban-client set bawls unbanip <ip>   (or <block>/64)

[bawls]
enabled   = true
filter    = bawls
logpath   = {{BAN_LOG}}
backend   = polling
maxretry  = 1
findtime  = 1h
bantime   = {{BAN_TIME}}
banaction = {{BANACTION}}
ignoreip  = {{IGNOREIP}}
