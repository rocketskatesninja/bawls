APP_NAME=Bawls
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
# Bounded by default: this service runs continuously, and an unrotated
# single-file log is how a monitoring box quietly fills its own disk.
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Set true when serving over TLS. Leave false for plain-HTTP LAN use,
# otherwise the session cookie is never sent and login silently fails.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# BAWLS SENSORS
# ---------------------------------------------------------------
# Sensor agents read these from /etc/bawls/sensor.env, not from
# here. Issue a token with:  php artisan bawls:sensor <name>
# Detection thresholds and retention live in config/bawls.php.
#
# Ingest filters. On a home network most events are the router's multicast
# chatter and machines talking to each other; dropping them at ingest keeps
# the database about traffic that crosses your boundary. Set either to false
# to store everything again.
BAWLS_DROP_INTERNAL=true
BAWLS_DROP_MULTICAST=true

# Secret console sign-in slug. The console login lives here instead of
# /login, so a scan for an admin login finds nothing. Set this to a random
# string; the app refuses to serve its web routes while it is empty or "login".
BAWLS_LOGIN_PATH=

# ---------------------------------------------------------------
# OSINT ENRICHMENT
# ---------------------------------------------------------------
# Passive IP intelligence for the dossier. MaxMind GeoLite2 is read from a local
# DB fetched by `php artisan bawls:geoip-update` (free license key from
# maxmind.com). The rest are optional — GreyNoise, Shodan InternetDB and RDAP
# work with no key; AbuseIPDB only adds data when a key is present.
MAXMIND_LICENSE_KEY=
ABUSEIPDB_KEY=
GREYNOISE_KEY=
# Enrich ordinary visitors too (default: only suspicious IPs).
BAWLS_ENRICH_BENIGN=false

# Alert webhook: POST new high-severity alerts here (ntfy/Slack/Discord/etc.).
# Unset = no notifications.
BAWLS_ALERT_WEBHOOK=
BAWLS_ALERT_MIN_SEVERITY=4

# Firewall ban feed (see deploy/fail2ban/). When enabled, new web_exploit
# alerts append to storage/logs/ban.log, which a fail2ban jail turns into a
# 7-day ban. BAWLS_NEVER_BLOCK: comma-separated IPv4 addresses/CIDRs that still
# alert but are never listed or banned — the server's own IPs and your admin IP
# (the installer fills these in; keep them in .env, never in git).
BAWLS_BAN_ENABLED=false
BAWLS_NEVER_BLOCK=
BAWLS_BAN_RULES=web_exploit
